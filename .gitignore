# secrets / env
.env
.env.local

# python
__pycache__/
*.pyc
*.egg-info/
# no trailing slash: .venv may be a symlink, which the dir-only `.venv/` misses
.venv
.pytest_cache/
.mypy_cache/

# data / models / runtime artifacts
data/
*.db
*.sqlite3
captures/

# model weights (downloaded on first run)
*.pth
*.pt
*.onnx
*.mat

# os / editor
.DS_Store
.idea/

# NOTE: the hub launcher ("Operation Love.command") is PORTABLE (resolves the
# project from its own location, uses the project .venv) and IS committed, so it
# travels with the repo to other machines.
