# secrets / env
.env
.env.local

# python
__pycache__/
*.pyc
*.egg-info/
# no trailing slash: .venv may be a symlink, which the dir-only `.venv/` misses
.venv
.pytest_cache/
.mypy_cache/

# data / models / runtime artifacts
data/
*.db
*.sqlite3
captures/

# Calibration captures: raw screencaps pulled off the phone to measure geometry
# (card gutters, heart positions, band rects). These are frames of REAL people's
# dating profiles -- faces, names, prompt answers -- so they must never reach a
# remote. The measurements taken FROM them belong in ops/*.md; the frames do not
# belong in git. Same reasoning as .env above: the artifact is local-only by rule,
# not by accident.
ops/calibration/

# model weights (downloaded on first run)
*.pth
*.pt
*.onnx
*.mat

# os / editor
.DS_Store
.idea/

# NOTE: the hub launcher ("Operation Love.command") is PORTABLE (resolves the
# project from its own location, uses the project .venv) and IS committed, so it
# travels with the repo to other machines.
