#!/bin/sh
# Local `act` gate for protected pushes, with short-lived commit-result reuse.
# It runs every job eligible for the push event, matching the required CI gate.
#
# Environment:
#   SKIP_ACT=1                 bypass once
#   ACT_PROTECTED_BRANCHES=... protected branch globs
#   ACT_ARCH=amd64             use linux/amd64 containers instead of the native image
#   ACT_ARGS=...               additional act flags
#   ACT_TIMEOUT=3600           maximum seconds for each local CI run (0 disables)
#   ACT_JOBS=N                 concurrent jobs (default 1)
#   ACT_CACHE=0                disable successful-result reuse
#   ACT_CACHE_TTL_SECONDS=N    reuse lifetime (default 24 hours)
#
# GIT HISTORY IS MOUNTED INTO act ON PURPOSE. This hook stages each push in a
# `git worktree add --detach` below, so the workspace's .git is a pointer FILE
# reading `gitdir: <real-git-dir>/worktrees/...`. act bind-mounts only the
# worktree directory, so without help that target -- and the object database it
# reaches through commondir -- is unreachable, git reports
# "not a git repository: (null)", and anything in CI that walks history is
# silently useless. That mattered little while act only mirrored GitHub CI. It
# matters completely now: GitHub Actions is disabled for this repository, so
# THIS hook is the CI, and a check that cannot run here does not run anywhere.
#
# So GIT_MOUNT below mounts the real git dir read-only at its own absolute path
# (the path the pointer file names, resolved at runtime via --git-common-dir --
# nothing machine-specific is baked into this tracked file). The INNER quotes in
# GIT_MOUNT are load-bearing: act splits --container-options on whitespace, and
# this repository's path contains a space, so an unquoted -v silently drops the
# mount rather than failing -- `act --verbose` shows `Binds:[]` when that
# happens. Read-only is deliberate: a container must never be able to write to
# the real object store, and every history walk CI does is plumbing that reads.
#
# The rejected alternative, recorded so it is not rediscovered: swapping
# `git worktree add` for `git clone --local` also works and needs no act flags,
# but only stays cheap while $TMPDIR shares a filesystem with the repository --
# across filesystems git silently falls back to COPYING a multi-GB object store
# on every protected push.
#
set -u

say() { printf '%s\n' "$*" >&2; }

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_QUARANTINE_PATH
REFS=$(cat)                              # always drain Git's input before returning
[ "${SKIP_ACT:-0}" = 1 ] && exit 0

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
PROTECTED=${ACT_PROTECTED_BRANCHES-"main master release release/* release-*"}

is_protected() {
	for pattern in $PROTECTED; do
		# shellcheck disable=SC2254
		case "$1" in $pattern) return 0 ;; esac
	done
	return 1
}

RUNS=""
while read -r _local_ref sha remote_ref before; do
	case "${remote_ref:-}" in refs/heads/*) branch=${remote_ref#refs/heads/} ;; *) continue ;; esac
	case "${sha:-}" in *[!0]*) ;; *) continue ;; esac   # ignore deletions
	is_protected "$branch" || continue
	git -C "$ROOT" cat-file -e "$sha^{commit}" 2>/dev/null || {
		say "pre-push: BLOCKED - cannot resolve pushed commit $sha"
		exit 1
	}
	workflows=$(git -C "$ROOT" ls-tree -r --name-only "$sha" -- .github/workflows 2>/dev/null) || {
		say "pre-push: BLOCKED - cannot inspect workflows in $sha"
		exit 1
	}
	[ -n "$workflows" ] || continue
	RUNS="${RUNS}${branch} ${sha} ${before}
"
done <<EOF
$REFS
EOF
[ -n "$RUNS" ] || exit 0

command -v act >/dev/null 2>&1 || {
	say "pre-push: BLOCKED - act is not installed (brew install act)"
	exit 1
}
docker info >/dev/null 2>&1 || {
	say "pre-push: BLOCKED - Docker is not running"
	exit 1
}

ARCH=""
if [ "${ACT_ARCH:-native}" = amd64 ] && [ "$(uname -s)" = Darwin ] && [ "$(uname -m)" = arm64 ]; then
	ARCH="--container-architecture linux/amd64"
fi

# The full serial pytest gate is intentionally memory-bounded and can exceed the
# former 900-second global-hook default. Keep a bounded one-hour safety limit so
# a stuck container still fails closed without canceling a healthy full run.
ACT_TIMEOUT=${ACT_TIMEOUT:-3600}
case "$ACT_TIMEOUT" in
*[!0-9]* | "")
	say "pre-push: BLOCKED - ACT_TIMEOUT must be a whole number of seconds (got '${ACT_TIMEOUT}')."
	exit 2
	;;
esac

case " ${ACT_ARGS:-} " in
*" --container-options"*)
	say "pre-push: BLOCKED - ACT_ARGS sets --container-options. act takes that flag last-wins, so"
	say "it would REPLACE the read-only git-dir mount this gate depends on, and the prompt-era"
	say "check would fail with a message about git rather than about your flag. Add what you need"
	say "to GIT_MOUNT in .githooks/pre-push instead."
	exit 2
	;;
esac

run_act() {
	if [ "$ACT_TIMEOUT" = 0 ]; then "$@"
	elif command -v timeout >/dev/null 2>&1; then timeout --preserve-status "$ACT_TIMEOUT" "$@"
	elif command -v gtimeout >/dev/null 2>&1; then gtimeout --preserve-status "$ACT_TIMEOUT" "$@"
	else "$@"
	fi
}

JOBS=${ACT_JOBS:-1}
case "$JOBS" in *[!0-9]* | "" | 0) JOBS=1 ;; esac

COMMON_DIR=$(git -C "$ROOT" rev-parse --git-common-dir 2>/dev/null) || COMMON_DIR=""
case "$COMMON_DIR" in /* | "") ;; *) COMMON_DIR="$ROOT/$COMMON_DIR" ;; esac
CACHE_DIR="$COMMON_DIR/act-ci-cache/v1"

# See the header. Empty when the real git dir cannot be resolved, in which case
# act runs without it and the workflow's own preflight reports the miss loudly
# rather than skipping the check.
# Resolved with `pwd -P` rather than reused from COMMON_DIR: `git rev-parse --git-common-dir`
# prints the SYMLINK spelling when .git is a symlink, while `git worktree add` writes a pointer
# file naming the RESOLVED target. Mounting the symlink spelling puts the objects somewhere
# nothing dereferences -- docker follows the link, so the bytes are there, at the wrong path --
# and git in the container still reports "not a git repository". `[ -d ]` cannot catch this
# because it follows symlinks too. CACHE_DIR deliberately keeps the unresolved spelling.
MOUNT_DIR=$(cd "$COMMON_DIR" 2>/dev/null && pwd -P) || MOUNT_DIR=""
GIT_MOUNT=""
if [ -n "$MOUNT_DIR" ]; then
	GIT_MOUNT="-v \"$MOUNT_DIR:$MOUNT_DIR:ro\""
fi
TTL=${ACT_CACHE_TTL_SECONDS:-86400}
case "$TTL" in *[!0-9]* | "") TTL=86400 ;; esac

digest() {
	if command -v shasum >/dev/null 2>&1; then shasum -a 256 | awk '{print $1}'
	elif command -v sha256sum >/dev/null 2>&1; then sha256sum | awk '{print $1}'
	else return 1
	fi
}

secret_digest=none
if [ -f "$ROOT/.secrets" ]; then
	secret_digest=$(digest <"$ROOT/.secrets") || secret_digest=unavailable
fi
CONTEXT=$(printf '%s\n' "hook=3" "jobs=all-push" "act=$(act --version 2>/dev/null)" \
	"arch=$ARCH" "args=${ACT_ARGS:-}" "secrets=$secret_digest" |
	digest) || CONTEXT=""

# Reuse across branches only when workflow text is branch-insensitive. If a
# future workflow introduces ref conditions or branch filters, cache entries
# automatically become destination-branch-specific.
scope_for() {
	sha=$1 branch=$2 sensitive=0
	paths=$(git -C "$ROOT" ls-tree -r --name-only "$sha" -- .github/workflows 2>/dev/null) || sensitive=1
	for path in $paths; do
		case "$path" in *.yml | *.yaml) ;; *) continue ;; esac
		if git -C "$ROOT" show "$sha:$path" 2>/dev/null | sed '/^[[:space:]]*#/d' |
			grep -Eq 'github\.(ref|ref_name|head_ref|base_ref)|github\.event\.(ref|head_ref|base_ref)|GITHUB_REF(_NAME)?|^[[:space:]]*branches(-ignore)?:'; then
			sensitive=1
			break
		fi
	done
	if [ "$sensitive" -eq 1 ]; then printf 'branch-%s\n' "$branch"; else printf 'any-ref\n'; fi
}

cache_path() { printf '%s/%s-%s-%s.passed\n' "$CACHE_DIR" "$1" "$CONTEXT" "$(scope_for "$1" "$2")"; }

cache_hit() {
	[ "${ACT_CACHE:-1}" != 0 ] && [ "$TTL" -gt 0 ] 2>/dev/null &&
		[ -n "$COMMON_DIR" ] && [ -n "$CONTEXT" ] || return 1
	file=$(cache_path "$1" "$2")
	[ -f "$file" ] || return 1
	IFS=' ' read -r when cached_sha <"$file" || return 1
	case "$when" in *[!0-9]* | "") return 1 ;; esac
	[ "$cached_sha" = "$1" ] || return 1
	now=$(date +%s)
	[ "$now" -ge "$when" ] && [ $((now - when)) -le "$TTL" ]
}

cache_store() {
	[ "${ACT_CACHE:-1}" != 0 ] && [ "$TTL" -gt 0 ] 2>/dev/null &&
		[ -n "$COMMON_DIR" ] && [ -n "$CONTEXT" ] || return 0
	file=$(cache_path "$1" "$2") parent=${file%/*}
	(umask 077 && mkdir -p "$parent" && printf '%s %s\n' "$(date +%s)" "$1" >"$file.tmp" &&
		mv "$file.tmp" "$file") || say "pre-push: WARNING - could not store act cache entry"
}

TMP=$(mktemp -d "${TMPDIR:-/tmp}/act-pre-push.XXXXXX") || exit 1
ACTIVE=""
cleanup() {
	[ -z "$ACTIVE" ] || git -C "$ROOT" worktree remove --force "$ACTIVE" >/dev/null 2>&1 || :
	rm -rf "$TMP"
}
trap cleanup EXIT HUP INT TERM

status=0
while read -r branch sha before; do
	[ -n "${branch:-}" ] || continue
	if cache_hit "$sha" "$branch"; then
		say "pre-push: cache hit for $branch at $sha - reusing recent act success"
		continue
	fi
	ACTIVE="$TMP/worktree"
	git -C "$ROOT" worktree add --detach --quiet "$ACTIVE" "$sha" || { status=1; break; }
	ref=$(printf '%s' "refs/heads/$branch" | sed 's/\\/\\\\/g; s/"/\\"/g')
	event="$TMP/event.json"
	printf '{"ref":"%s","after":"%s","before":"%s"}\n' "$ref" "$sha" "$before" >"$event"
	say "pre-push: validating all push-triggered jobs for $branch at $sha"
	cd "$ACTIVE" || { status=1; break; }
	set -f
	# Built positionally rather than as one long command line so that
	# --container-options reaches act as a SINGLE argument with its inner quotes
	# intact; word-splitting it is exactly the failure that silently drops the
	# mount. $ARCH and $ACT_ARGS stay deliberately unquoted (each may be empty or
	# several words) and `set -f` above makes that safe from globbing.
	set -- act push --eventpath "$event"
	[ -f "$ROOT/.secrets" ] && set -- "$@" --secret-file "$ROOT/.secrets"
	# shellcheck disable=SC2086
	set -- "$@" $ARCH --concurrent-jobs "$JOBS"
	[ -n "$GIT_MOUNT" ] && set -- "$@" --container-options "$GIT_MOUNT"
	# shellcheck disable=SC2086
	set -- "$@" ${ACT_ARGS:-}
	run_act "$@" </dev/null
	status=$?
	set +f
	cd "$ROOT" || status=1
	git -C "$ROOT" worktree remove --force "$ACTIVE" >/dev/null 2>&1 || status=1
	ACTIVE=""
	[ "$status" -eq 0 ] || break
	cache_store "$sha" "$branch"
done <<EOF
$RUNS
EOF

if [ "$status" -ne 0 ]; then
	say "pre-push: BLOCKED - act exited $status"
	say "pre-push: local CI timeout is ${ACT_TIMEOUT}s (override with ACT_TIMEOUT=N; 0 disables)."
	exit "$status"
fi
say "pre-push: all required push jobs passed (including cached exact-commit results) - pushing"
